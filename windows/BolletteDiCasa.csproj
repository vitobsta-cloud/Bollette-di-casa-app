<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BolletteDiCasa</AssemblyName>
    <RootNamespace>BolletteDiCasa</RootNamespace>
    <ApplicationIcon>bollette.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Company>TR/software</Company>
    <Product>Bollette di casa</Product>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <Ramo Condition="'$(Ramo)' == ''">main</Ramo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Ramo</_Parameter1>
      <_Parameter2>$(Ramo)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- l'interfaccia è la stessa del telefono: viene copiata accanto al programma -->
    <Content Include="..\app\src\main\assets\www\**\*" Link="www\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
